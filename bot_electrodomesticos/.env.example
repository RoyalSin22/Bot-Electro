GEMINI_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WEBHOOK_VERIFY_TOKEN=
GOOGLE_SHEET_ID=
# JSON de la cuenta de servicio en una sola línea (nunca subir al repositorio)
GOOGLE_CREDENTIALS_JSON=
# Secreto de la app de Meta (App settings > Basic). Si se define, el webhook rechaza
# peticiones sin firma válida. Muy recomendado en cualquier despliegue público.
WHATSAPP_APP_SECRET=
# Versión de la Graph API (opcional)
WHATSAPP_API_VERSION=v23.0
# Opcional: números (separados por coma) a los que el bot SÍ responde; los demás se ignoran.
# Ej.: NUMEROS_PERMITIDOS=51999111222
NUMEROS_PERMITIDOS=
